{
  "name": "editcut",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:web": "vite",
    "build": "vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:ops": "tsx scripts/test-ops.ts",
    "test:ai": "tsx scripts/test-ai-tools.ts",
    "test:export": "tsx scripts/test-export.ts",
    "test": "npm run typecheck && npm run test:ops && npm run test:ai && npm run test:export"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.1.0",
    "dockview-react": "^8.6.1",
    "express": "^5.3.0",
    "immer": "^11.2.9",
    "lucide-react": "^1.61.0",
    "multer": "^2.5.0",
    "nanoid": "^5.1.16",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "tsx": "^4.23.15",
    "typescript": "5.9",
    "vite": "^8.3.5"
  }
}